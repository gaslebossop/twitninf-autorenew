# /etc/twitninf/autorenew.env   —   chmod 0640, chown root:debian
#
# Seule ARW_PGURI est obligatoire. Tout le reste a une valeur par défaut
# alignée sur la configuration de l'API.

# Connexion Postgres (même base que l'API TwitNinf).
#
# ⚠ TOUJOURS entre guillemets. La forme mot-clé de libpq contient des espaces :
# systemd lit bien la ligne entière, mais un `. /etc/twitninf/autorenew.env`
# dans un shell (pour une passe manuelle) s'arrête au premier espace et le
# démon repart avec « no password supplied ». Les guillemets font marcher les
# deux, et systemd les retire lui-même.
ARW_PGURI="host=localhost port=5432 dbname=twitninf user=admin password=MOT_DE_PASSE"

# Compte de trésorerie de la plateforme (economy/constants.js)
# ARW_TREASURY_USER_ID=01837802-c2ae-4de0-9471-7a9b642afde2

# Cadence de la boucle. Court volontairement : la cadence de réessai est portée
# par next_retry_at en base, pas par le sommeil du process.
# ARW_TICK_SECONDS=60
# ARW_BATCH_SIZE=200

# Impayé : réessai toutes les 3 h, mise en demeure au 20e échec (~60 h),
# puis 30 jours pour régulariser. L'abonnement reste actif tout du long.
# ARW_RETRY_HOURS=3
# ARW_MAX_FAILURES=20
# ARW_GRACE_DAYS=30

# Durée d'une période d'abonnement (constants/subscriptionTiers.js)
# ARW_PERIOD_DAYS=5

# Crédits de génération rechargés à chaque paiement confirmé
# ARW_TWEET_CREDITS=5

# Tarifs. Plus et Pro sont en EUROS et reconvertis au cours du NF à chaque
# échéance ; Ultra est en NF fixe et ne dépend pas du cours.
# ARW_PRICE_EUR_PLUS=15
# ARW_PRICE_EUR_PRO=30
# ARW_PRICE_NF_ULTRA=300

# Simulation : sélectionne, calcule et journalise les prélèvements sans écrire
# la moindre ligne. À utiliser pour la première mise en service.
# ARW_DRY_RUN=1
# ARW_VERBOSE=1
